{
  "name": "@pi-office/pi-office-pack",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./defaults": {
      "types": "./dist/defaults.d.ts",
      "import": "./dist/defaults.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    },
    "./prompt-suggestions": {
      "types": "./dist/prompt-suggestions.d.ts",
      "import": "./dist/prompt-suggestions.js"
    },
    "./workflow-packs": {
      "types": "./dist/workflow-packs.d.ts",
      "import": "./dist/workflow-packs.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "import": "./dist/capabilities.js"
    },
    "./mcp-result-store": {
      "types": "./dist/mcp-result-store.d.ts",
      "browser": "./dist/mcp-result-store.js",
      "import": "./dist/mcp-result-store.js",
      "default": "./dist/mcp-result-store.js"
    },
    "./provider-model-preferences": {
      "types": "./dist/provider-model-preferences.generated.d.ts",
      "import": "./dist/provider-model-preferences.generated.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.64.0",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.7.3"
  }
}
