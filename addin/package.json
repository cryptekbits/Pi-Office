{
  "name": "pi-office",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "npm run prepare:certs && npm run preflight:dev && npm-run-all --parallel dev:pack dev:taskpane",
    "dev:pack": "npm run dev --workspace @pi-office/pi-office-pack",
    "dev:taskpane": "npm run dev --workspace @pi-office/taskpane",
    "build": "npm-run-all build:pack build:taskpane",
    "build:pack": "npm run build --workspace @pi-office/pi-office-pack",
    "build:taskpane": "npm run build --workspace @pi-office/taskpane",
    "typecheck": "npm-run-all typecheck:pack typecheck:taskpane",
    "typecheck:pack": "npm run typecheck --workspace @pi-office/pi-office-pack",
    "typecheck:taskpane": "npm run typecheck --workspace @pi-office/taskpane",
    "test:office": "node ./scripts/run-office-tests.mjs",
    "smoke:office": "node ./scripts/run-office-smoke.mjs",
    "smoke:office:word": "node ./scripts/run-office-smoke.mjs --host word",
    "smoke:office:excel": "node ./scripts/run-office-smoke.mjs --host excel",
    "smoke:office:powerpoint": "node ./scripts/run-office-smoke.mjs --host powerpoint",
    "prepare:certs": "node ./scripts/ensure-dev-certs.mjs",
    "preflight:dev": "node ./scripts/preflight-dev-runtime.mjs",
    "preflight:sideload": "node ./scripts/preflight-sideload.mjs",
    "check:bundle": "node ./scripts/check-bundle-budget.mjs",
    "generate:icons": "node ./scripts/generate-brand-icons.mjs",
    "validate:manifests": "node ./scripts/validate-manifests.mjs",
    "presideload:word": "npm run preflight:sideload",
    "sideload:word": "npx --yes office-addin-debugging@6.0.7 start manifests/word.xml",
    "presideload:excel": "npm run preflight:sideload",
    "sideload:excel": "npx --yes office-addin-debugging@6.0.7 start manifests/excel.xml",
    "presideload:powerpoint": "npm run preflight:sideload",
    "sideload:powerpoint": "npx --yes office-addin-debugging@6.0.7 start manifests/powerpoint.xml",
    "sideload:stop": "npx --yes office-addin-debugging@6.0.7 stop"
  },
  "overrides": {
    "uuid": "14.0.0"
  },
  "dependencies": {
    "mermaid": "^11.14.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3"
  }
}
